# GitHub personal-access token with repo read permissions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Devin API key (Bearer token)
DEVIN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository in "owner/repo" format
GITHUB_REPO_NAME=finserv-co/backend-services

# Label used to filter backlog issues (default: devin-backlog)
GITHUB_ISSUE_LABEL=devin-backlog

# Session polling configuration (optional)
DEVIN_POLL_INTERVAL=30
DEVIN_POLL_TIMEOUT=600

# Slack incoming webhook URL (optional — if set, real notifications are sent)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXX/BXXXXXX/xxxxxxxxxxxxxxxx
